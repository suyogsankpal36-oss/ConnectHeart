# ==============================================================================
# CONNECTHEARTS BACKEND — PRODUCTION & LOCAL ENVIRONMENT VARIABLES (.env.example)
# Do NOT place real secrets in this template or commit real .env files to Git.
# ==============================================================================

# Server Environment & Port (Assigned dynamically by Render or set manually)
NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection URI
# In Render: Set privately in Dashboard > Environment Variables
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/connecthearts?retryWrites=true&w=majority

# Local Development Fallback (Used only when NODE_ENV !== 'production')
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/connecthearts

# JWT Signing Secret (Must be >= 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend Origins for CORS & Socket.IO Security
# Set to your deployed Netlify or Vercel domain (e.g. https://connecthearts.netlify.app)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://connecthearts.netlify.app,https://connecthearts.vercel.app

# Optional Cloudinary Storage for Multi-Region Media Hosting
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
